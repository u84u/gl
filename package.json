{
  "name": "@u84u/gl",
  "version": "0.1.1",
  "description": "Compiler for the gl shading language, transpiling to GLSL (450, ES 3.00) and WGSL",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "gl": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/resolver.d.ts",
      "default": "./dist/node/resolver.js"
    },
    "./browser": {
      "types": "./dist/browser/resolver.d.ts",
      "default": "./dist/browser/resolver.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:render": "vitest run test/render.test.ts",
    "install:browsers": "playwright install chromium",
    "coverage": "vitest run --coverage",
    "lsp": "tsx src/lsp/server.ts",
    "prepack": "npm run build",
    "test:package": "node scripts/package-smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/u84u/gl.git"
  },
  "keywords": [
    "glsl",
    "wgsl",
    "shader",
    "compiler",
    "transpiler"
  ],
  "author": "u84u",
  "license": "CC-BY-4.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "commander": "^13.0.0",
    "naga-wasi-cli": "^0.1.0",
    "playwright": "^1.65.1",
    "tsup": "^8.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vitest": "^5.1.0"
  }
}
